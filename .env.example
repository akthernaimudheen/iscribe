# iScribe deployment configuration — copy to .env and fill in.
# NEVER commit .env. Values below are placeholders, not real secrets.

# ---- deployment -----------------------------------------------------------
ISCRIBE_ENV=production
ISCRIBE_HOST=127.0.0.1
ISCRIBE_PORT=8123

# ---- access control -------------------------------------------------------
# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ISCRIBE_ACCESS_TOKEN=
ISCRIBE_SESSION_HOURS=12
# Set to false ONLY if serving plain HTTP on a trusted LAN without TLS.
ISCRIBE_COOKIE_SECURE=true
# Leave empty for same-origin only (frontend served by this app). Comma-separated.
ISCRIBE_CORS_ORIGINS=

# ---- storage --------------------------------------------------------------
# Holds the consultation database, uploaded audio and logs. Back this up.
ISCRIBE_DATA_DIR=./data
# Separate storage namespace for authorized training audio (fail-closed).
ISCRIBE_TRAINING_VAULT_DIR=

# ---- tenancy ---------------------------------------------------------------
# Server-assigned hospital boundary stamped onto every consultation. Client
# request data can never change it. Use the hospital's own identifier.
ISCRIBE_HOSPITAL_ID=default

# ---- audio retention (lifecycle-driven) ------------------------------------
# After explicit doctor approval, audio is deleted approval + N hours
# (0 = deleted as soon as the sweep runs after approval).
ISCRIBE_AUDIO_RETENTION_AFTER_APPROVAL_HOURS=24
# Audio never approved is kept this many hours from upload so review stays
# possible, then deleted. 0 disables the ceiling (not recommended).
ISCRIBE_AUDIO_RETENTION_UNREVIEWED_HOURS=168
# How often the lifecycle sweep evaluates deadlines (seconds).
ISCRIBE_RETENTION_SWEEP_SECONDS=900

# ---- training retention (FAIL-CLOSED; all defaults deny) --------------------
# Master switch. False => no audio can ever enter the training dataset.
ISCRIBE_TRAINING_RETENTION_ENABLED=false
# Training copies have their own expiry, counted from training-copy creation.
ISCRIBE_TRAINING_RETENTION_PERIOD_HOURS=8760
# Require an explicit per-recording training selection (recommended).
ISCRIBE_TRAINING_REQUIRES_EXPLICIT_SELECTION=true
# Require a current hospital training authorization before any selection.
ISCRIBE_TRAINING_REQUIRES_HOSPITAL_AUTHORIZATION=true
# Separate credential allowed to grant/revoke training authorization.
# Leave EMPTY to disable training administration entirely (fail closed).
ISCRIBE_TRAINING_ADMIN_TOKEN=

# ---- limits ---------------------------------------------------------------
ISCRIBE_MAX_UPLOAD_MB=100
# Uploaded audio is deleted this many hours after the consultation is created.
# Set to 0 to keep audio indefinitely (not recommended).
ISCRIBE_AUDIO_RETENTION_HOURS=24
# Keep at 1 on a host with <8 GB RAM.
ISCRIBE_MAX_CONCURRENT_JOBS=1

# ---- engine ---------------------------------------------------------------
# Production path is ENGLISH ONLY and never auto-detects the language.
ISCRIBE_LANGUAGE=en
# Leave EMPTY for automatic priority: Deepgram when a key is set, else
# faster-whisper. Set to pin one provider explicitly.
ISCRIBE_STT_PROVIDER=
# Fail-closed STT: when enabled, a provider failure NEVER falls back to another
# provider — the job fails safely (retryable), source audio stays under the
# normal retention lifecycle, and the failure is audited. Unexpected provider
# switching is a privacy, residency, auditability and reproducibility risk.
# Default when ISCRIBE_STT_FAIL_CLOSED is unset: false in development, TRUE in
# production (derived from ISCRIBE_ENV at runtime — the runtime default is
# authoritative, not this file). An explicit value here always overrides it.
ISCRIBE_STT_FAIL_CLOSED=
# Pre-flight provider-boundary policy check: the provider's declared
# retention posture, region and off-host behaviour must satisfy the hospital
# policy before any audio is sent (refusal is explicit and audited).
ISCRIBE_STT_POLICY_ENFORCED=true

# ---- Deepgram (optional; faster-whisper is used when unset) ---------------
# SECRET. Never commit. Without it the app runs on local faster-whisper.
DEEPGRAM_API_KEY=
ISCRIBE_DEEPGRAM_MODEL=nova-3-medical
# Data-residency endpoint: global | eu | au | in. 'global' (api.deepgram.com)
# carries NO residency guarantee; regional endpoints process and store data
# in-region (provider-documented). Full residency also requires MIP opt-out.
ISCRIBE_DEEPGRAM_REGION=global
# Model Improvement Program opt-out = zero data retention on Deepgram's side
# (audio+transcript retained only to process the request). Default ON for
# clinical audio; off means participation in Deepgram model training.
ISCRIBE_DEEPGRAM_MIP_OPT_OUT=true
ISCRIBE_WHISPER_MODEL=base
ISCRIBE_WHISPER_DEVICE=cpu
ISCRIBE_WHISPER_COMPUTE_TYPE=int8
# Cap CTranslate2 threads so transcription cannot starve the web server.
# 0 = all cores. Keep at or below (cores - 2) on a shared machine.
ISCRIBE_WHISPER_CPU_THREADS=4
ISCRIBE_PRELOAD_MODELS=true

# ---- logging --------------------------------------------------------------
ISCRIBE_LOG_LEVEL=INFO

# ---- model cache ----------------------------------------------------------
# After the first successful model download, set this to 1 so startup never
# waits on huggingface.co (faster and works offline).
HF_HUB_OFFLINE=0
